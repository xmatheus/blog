---
import Icon from '@/components/ui/Icon.astro'

interface Props {
  href?: string
  class?: string
}

const { href = '/', class: className } = Astro.props
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-1.5 text-sm text-quaternary-color transition-colors hover:text-primary-color group',
    className,
  ]}
>
  <Icon name="arrow-left" size={14} class="transition-transform group-hover:-translate-x-0.5" />
  <slot />
</a>
