---
import type { Project } from '@/data/projects'
import Icon from '@/components/ui/Icon.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<a
  href={project.link}
  target="_blank"
  rel="noreferrer"
  class="group block rounded-xl border border-subtle p-4 transition-all duration-200 hover-bg"
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-medium text-primary-color group-hover:underline underline-offset-2">
      {project.title}
    </h3>
    <Icon
      name="arrow-up-right"
      size={14}
      class="mt-0.5 shrink-0 text-quaternary-color transition-all group-hover:text-primary-color group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    />
  </div>
  <p class="mt-1.5 text-sm text-secondary-color leading-relaxed line-clamp-2">
    {project.description}
  </p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {project.tags.map(tag => <span class="text-[11px] text-tertiary-color font-mono">{tag}</span>)}
  </div>
</a>
