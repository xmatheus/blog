---
import { postUrl, type Post } from '@/lib/posts'
import { formatShortDate } from '@/lib/date'

interface Props {
  post: Post
}

const { post } = Astro.props
---

<a
  href={postUrl(post)}
  class="group flex flex-col gap-0 sm:flex-row sm:items-center sm:gap-2 py-2 -mx-2 px-2 rounded-lg transition-colors hover-bg"
>
  <div class="flex items-center gap-2 flex-1 min-w-0">
    <span class="text-primary-color font-medium leading-snug line-clamp-1 group-hover:underline underline-offset-2">
      {post.data.title}
    </span>
  </div>
  <span class="text-quaternary-color text-sm shrink-0 font-mono tabular-nums">
    {formatShortDate(post.data.createdAt)}
  </span>
</a>
