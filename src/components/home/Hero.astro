---
import { Image } from 'astro:assets'
import SocialLinks from '@/components/ui/SocialLinks.astro'
import { AUTHOR, SKILLS } from '@/config/site'
import avatar from '@/assets/eu.webp'
---

<section class="flex flex-col gap-5 animate-in">
  <div class="flex items-center gap-4">
    <Image src={avatar} alt={AUTHOR.name} width={56} densities={[1, 2]} loading="eager" fetchpriority="high" class="rounded-full aspect-auto" />
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">{AUTHOR.role}</h1>
      <p class="text-sm text-secondary-color">{AUTHOR.name}</p>
    </div>
  </div>
  <p class="text-secondary-color leading-relaxed text-pretty animate-in delay-1">
    {AUTHOR.bio}
  </p>

  <div class="flex flex-wrap gap-2 animate-in delay-2">
    {
      SKILLS.map(skill => (
        <span class="text-xs font-medium text-tertiary-color border border-subtle px-2.5 py-1 rounded-full transition-colors hover:text-secondary-color hover:border-[var(--color-tertiary)]">
          {skill}
        </span>
      ))
    }
  </div>

  <SocialLinks class="animate-in delay-3" />
</section>
