---
import SeoHead, { type SeoProps } from '@/components/seo/SeoHead.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import GoogleAnalytics from '@/components/seo/GoogleAnalytics.astro'
import Background from '@/components/layout/Background.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import { SITE, AUTHOR } from '@/config/site'
import '@/styles/global.css'

interface Props extends SeoProps {
  jsonLd?: Record<string, unknown>[]
}

const { jsonLd = [], ...seo } = Astro.props

const siteJsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: AUTHOR.fullName,
    url: SITE.url,
    jobTitle: AUTHOR.role,
    sameAs: [AUTHOR.github, AUTHOR.instagram, AUTHOR.dribbble],
  },
]
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Applies the saved theme before first paint to avoid a flash -->
    <script is:inline>
      ;(function () {
        try {
          var t = localStorage.getItem('theme')
          document.documentElement.classList.add(t === 'light' || t === 'dark' ? t : 'dark')
        } catch (e) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <SeoHead {...seo} />
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen font-satoshi antialiased">
    <JsonLd data={[...siteJsonLd, ...jsonLd]} />
    <Background />
    <Header />
    <main class="mx-auto max-w-2xl px-5 py-16 sm:py-24">
      <slot />
    </main>
    <Footer />
  </body>
</html>
