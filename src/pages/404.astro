---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BackLink from '@/components/ui/BackLink.astro'
---

<BaseLayout title="404">
  <div class="flex flex-col items-center justify-center py-24 text-center gap-4 animate-in">
    <h1 class="text-6xl font-semibold tracking-tighter text-quaternary-color">404</h1>
    <p class="text-secondary-color">Pagina nao encontrada</p>
    <BackLink class="mt-4">Voltar para o inicio</BackLink>
  </div>
</BaseLayout>
